# SOURCE: letta/security/secret_scanner.py
#
# This is the ACTUAL LettaLocal framework code that detects secrets
# in tool arguments. It is used by the CONTAINS_SECRET policy operator
# in policy.py. When fixed.yaml sets policy rules that use CONTAINS_SECRET,
# this scanner runs on every matching tool call.
#
# Two detection signals:
# 1. Entropy: High Shannon entropy (>=4.5 bits/char) in strings of 20+
#    characters. This catches unknown formats without needing to enumerate
#    every provider's secret format.
# 2. Regex: Well-known secret formats (AWS keys, GitHub tokens, PEM
#    private keys, etc.) as a confirmatory signal.

import math
import re
from collections import Counter


_ENTROPY_THRESHOLD = 4.5   # bits per character
_ENTROPY_MIN_LENGTH = 20   # minimum string length to check


def shannon_entropy(data):
    """Calculate Shannon entropy of a string in bits per character.

    Random strings (API keys, tokens) have high entropy (~4.5-6.0).
    Natural language has low entropy (~3.0-4.0).
    This is the primary signal for detecting unknown secret formats.
    """
    if not data:
        return 0.0
    counts = Counter(data)
    length = len(data)
    return -sum((c / length) * math.log2(c / length) for c in counts.values())


def is_high_entropy(s):
    """Return True if the string has high enough entropy to be a secret."""
    return len(s) >= _ENTROPY_MIN_LENGTH and shannon_entropy(s) >= _ENTROPY_THRESHOLD


# --- Regex patterns (confirmatory signal) ---
# Deliberately short — entropy catches the long tail.

SECRET_PATTERNS = [
    (re.compile(r"AKIA[0-9A-Z]{16}"), "AWS Access Key ID"),
    (re.compile(r"-----BEGIN (?:RSA |EC |DSA )?PRIVATE KEY-----"), "Private key (PEM)"),
    (re.compile(r"gh[psou]_[A-Za-z0-9_]{36,}"), "GitHub token"),
    (re.compile(r"xox[bpa]-[A-Za-z0-9\-]{10,}"), "Slack token"),
    (re.compile(r"(?:sk|rk)_live_[A-Za-z0-9]{24,}"), "Stripe key"),
]


class SecretPatternChecker:
    """Stateless checker — call SecretPatternChecker.check(value).

    Used by: CONTAINS_SECRET policy operator in policy.py
    Enabled by: policy rules in fixed.yaml that use the CONTAINS_SECRET condition
    """

    @staticmethod
    def check(value):
        """Check a string for secret patterns. Returns a label or None.

        When a secret is detected:
        1. The policy engine can AUDIT (log but allow) or DENY the tool call
        2. A SECRET_DETECTED event is written to the audit log
        3. The secret never enters the LLM context window if the action is DENY
        """
        if not isinstance(value, str) or not value:
            return None

        # 1. Regex check — known formats (AWS keys, GitHub tokens, etc.)
        for pattern, label in SECRET_PATTERNS:
            if pattern.search(value):
                return label

        # 2. Entropy check — scan for high-entropy substrings of 20+ chars
        #    This catches unknown secret formats that the regex list doesn't cover
        for token in re.findall(r"\S{20,}", value):
            if is_high_entropy(token):
                return "High-entropy secret"

        return None


# DEFENSE SUMMARY:
#   When fixed.yaml includes policy rules with CONTAINS_SECRET conditions:
#   - SecretPatternChecker scans tool arguments for known secret formats
#   - High-entropy strings are flagged as potential secrets
#   - The policy action (AUDIT or DENY) controls whether the call proceeds
#   - A SECRET_DETECTED event is logged for audit
#
#   Note: No source_access_control.py module exists in the fork.
#   File access restriction is done via policy rules (denied_tools, path rules).
#   The SecretPatternChecker catches secrets in tool args; tool_output_validator
#   delegates to ContentValidator which detects INJECTION patterns in tool
#   outputs — it does not scan for secrets. There is no output-side secret
#   scanning in the framework.
