# SOURCE: letta/security/tool_output_validator.py (as of LettaLocal 0.16.34)
#
# This is the ACTUAL LettaLocal framework code that scans tool outputs
# for prompt injection before they re-enter the LLM context window.
#
# When a tool (file_read, archival_memory_search) returns content, that
# content re-enters the LLM context with no validation by default. A
# poisoned web page or document can inject instructions through tool
# output. This module detects that — and v0.16.34 adds the ACTION knob:
# warn (default; append [SECURITY WARNING], content passes), strip
# (replace with a generic stub), or error (return an error-status result
# naming the detection; the content never enters context — the mode
# LLM05's fixed state uses).
#
# Enabled by: agent.tool_output_validation_enabled (default False)
#            Set via content_validation: true in fixed.yaml
# Action: agent.tool_output_action (metadata; default warn)
#            Set via tool_output_action: "error" in fixed.yaml
# Called by: letta_agent_v3.py after each tool execution
# Fail-open: if the validator crashes, the tool result passes through unchanged
# v0.16.32: returns (warning, label) — the label feeds the security-flag
#           propagation layer (SSE badge, run metadata)
# v0.16.33: step_id/run_id passed EXPLICITLY from the call site (the
#           old _current_* attribute reads were never set anywhere —
#           injection events carried run_id None on every path)
# v0.16.34: QUARANTINE_STUB / QUARANTINE_ERROR constants — the texts the
#           strip/error actions substitute at the boundary

QUARANTINE_STUB = "[Tool output withheld by security policy.]"

QUARANTINE_ERROR = (
    "Tool call blocked by security policy: potential prompt injection "
    "detected in tool output ({label}). Content not delivered."
)


async def validate_tool_output(
    tool_name: str,
    tool_result: str,
    agent: "BaseAgentV2",
    step_id: Optional[str] = None,
    run_id: Optional[str] = None,
) -> tuple[Optional[str], Optional[str]]:
    """Scan a tool result for prompt injection patterns. Fail-open.

    Returns a warning string if injection is detected, None if clean.
    The caller should append the warning to the tool result before
    it enters the LLM context window.

    Args:
        tool_name: Name of the tool that produced the result.
        tool_result: The tool's return value as a string.
        agent: The agent instance (for feature flag and audit logger).
        step_id: Step context for the audit event (explicit at the call
            site — the tool_executed-logger pattern; v0.16.33).
        run_id: Run context for the audit event (same pattern).

    Returns:
        Tuple of (warning_string, label). Both None if clean or disabled.
        The label is the detection class (e.g. "instruction_override") —
        consumed by the security-flag propagation layer (v0.16.32).
    """
    try:
        # Feature flag — default off (Delta unaffected)
        enabled = getattr(agent, "tool_output_validation_enabled", False)
        if not enabled:
            return None, None

        from letta.security.content_validator import ContentValidator

        label = ContentValidator.check(tool_result)
        if label is not None:
            from letta.security import audit_helpers as _ah

            await _ah.log_injection_detected(
                agent.audit_logger,
                agent.agent_id,
                agent.actor,
                tool_name,
                label,
                step_id,
                run_id,
            )
            return f"\n\n[SECURITY WARNING: Potential prompt injection detected in tool output ({label})]", label

        return None, None

    except Exception as e:
        logger.warning(f"Tool output validation failed (fail-open): {e}")
        return None, None


# DEFENSE SUMMARY:
#   When content_validation: true is set in fixed.yaml:
#   - Every tool output is scanned by ContentValidator before re-entering context
#   - An INJECTION_DETECTED event is logged to the audit trail
#   - The ACTION (v0.16.34, agent.tool_output_action) decides what happens
#     to flagged content: warn appends [SECURITY WARNING] and passes it;
#     strip replaces it with a generic stub; error returns an error-status
#     result naming the detection — the content never enters context.
#     LLM05's fixed state uses error (see fixed.yaml).
#   - The security flags (badge, events, run metadata) fire under every
#     action — visibility is action-independent
#
#   This is the same ContentValidator used for tool arguments (see LLM01's
#   fixed_code). The scanner covers 6 pattern categories:
#   1. Direct instruction overrides
#   2. Role redefinition
#   3. Role-play markers ([SYS], <<SYS>>, etc.)
#   4. Delimiter injection (--- SYSTEM ---)
#   5. Hidden Unicode (zero-width, RTL override)
#   6. Base64-encoded instructions
