# Epsilon configuration template.
#
# Every value below is commented out and OPTIONAL — the app runs with
# sensible defaults for a local `docker compose up` deployment. Copy
# this file to `.env` and uncomment only what you want to change.
#
# NOTE: docker-compose.yml already sets the in-network values (service
# names, database URLs) for the containerized deployment. The entries
# here matter when you run components OUTSIDE docker compose, or want
# to override a default.

# --- Backend ---

# URL of the LettaLocal agent server.
# Inside docker compose: http://letta-local:8283 (set by compose).
# Outside docker compose: http://localhost:8283
# LETTA_URL=http://localhost:8283

# URL of your local Ollama instance.
# Inside docker compose: http://host.docker.internal:11434 (set by compose).
# Outside docker compose: http://localhost:11434
# OLLAMA_URL=http://localhost:11434

# Database and cache. The compose deployment uses its own postgres and
# redis services; set these only when running the backend standalone.
# DATABASE_URL=postgresql+asyncpg://epsilon:epsilon@localhost:5432/epsilon
# REDIS_URL=redis://localhost:6379/0

# Secret key for JWT signing. Auto-generated on each start if unset —
# set a fixed random value to keep login sessions across restarts.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=

# Access token lifetime in minutes.
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Models (must be pulled into Ollama first) ---

# Chat model (with provider prefix).
# ollama pull nemotron-3-nano:4b
# OLLAMA_MODEL=ollama/nemotron-3-nano:4b

# Embedding model for archival memory.
# ollama pull embeddinggemma:latest
# LETTA_EMBEDDING_MODEL=ollama/embeddinggemma:latest

# --- Frontend ---

# API URL the frontend calls. Only needed when building the frontend
# outside docker compose (Vite bakes this at build time).
# VITE_API_URL=http://localhost:8000

# --- Platform-specific ---

# DNS over TCP — Linux only (LettaLocal's Landlock sandbox blocks UDP
# DNS). Windows/macOS: leave empty. Linux: set to "use-vc".
# RES_OPTIONS=
